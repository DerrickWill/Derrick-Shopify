{%- doc -%}
  Product badge styles consolidated into a single snippet.

  @example
  {% render 'product-badges-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-badges {
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));

    position: absolute;
    z-index: var(--layer-flat);
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    right: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges__badge {
    --badge-font-size: var(--font-size--xs);

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: var(--badge-font-weight);
    text-transform: var(--badge-text-transform);
    border-radius: var(--badge-border-radius);
  }

  .product-badges__badge--rectangle {
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);
  }

  .product-badges__badge--special-offer {
    background: #c8f53e;
    color: #1a1a1a;
    font-weight: 700;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .product-badges__badge--discount {
    background: #1a1a2e;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.8rem;
    border-radius: 50px;
    padding: 6px 10px;
    min-width: 44px;
    text-align: center;
  }

  .price__savings {
    color: #f5a623;
    font-weight: 600;
    font-size: 0.875rem;
    margin-top: 2px;
  }

  product-card .price,
  product-card .price-item--sale {
    color: #ff0000 !important;
  }

  .product-inventory-stats {
    display: flex;
    gap: 16px;
    color: #888888;
    font-size: 0.78rem;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #e8e8e8;
  }

  .product-card-atc-wrapper {
    margin-top: auto;
    padding-top: 12px;
    width: 100%;
  }

  .product-card-atc-wrapper product-form-component {
    display: block;
    width: 100%;
  }

  .product-card-atc-wrapper form {
    width: 100%;
  }

  product-card .add-to-cart-button {
    background-color: #1a1a2e !important;
    color: #ffffff !important;
    border-color: #1a1a2e !important;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 6px;
  }

  product-card .add-to-cart-button:hover:not(:disabled) {
    background-color: #2d2d50 !important;
    border-color: #2d2d50 !important;
    color: #ffffff !important;
  }

  product-card .add-to-cart-button .add-to-cart-icon svg {
    fill: #ffffff;
    stroke: #ffffff;
  }
{% endstylesheet %}
