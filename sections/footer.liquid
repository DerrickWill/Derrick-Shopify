{{ 'footer-custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'footer-custom.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign company_menu = linklists[section.settings.company_menu]
  assign policy_menu  = linklists[section.settings.policy_menu]
-%}

<!-- ============================================================
     NEWSLETTER BAR
     ============================================================ -->
{%- if section.settings.show_newsletter -%}
<div class="footer-newsletter">
  <div class="footer-newsletter__inner">

    <div class="footer-newsletter__left">
      <span class="footer-newsletter__icon" aria-hidden="true">
        <svg width="22" height="18" viewBox="0 0 22 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="1" width="20" height="16" rx="2"/>
          <polyline points="1,1 11,10 21,1"/>
        </svg>
      </span>
      <span class="footer-newsletter__heading">{{ section.settings.newsletter_heading | default: 'Sign up for savings' }}</span>
    </div>

    <p class="footer-newsletter__sub">{{ section.settings.newsletter_subtext | default: 'Get the latest deals and special offers.' }}</p>

    <div class="footer-newsletter__form-wrap">
      {%- form 'customer', id: 'footerNewsletterForm', class: 'footer-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="footer-newsletter__success">{{ 'general.newsletter.confirmation' | t | default: 'Thank you for subscribing!' }}</p>
        {%- else -%}
          <div class="footer-newsletter__field">
            <input
              type="email"
              name="contact[email]"
              id="footerEmail"
              class="footer-newsletter__input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}"
              autocomplete="email"
              required
              aria-label="Email address"
            >
            <button type="submit" class="footer-newsletter__btn">
              {{ section.settings.newsletter_btn | default: 'Subscribe' }}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="footer-newsletter__error">{{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</div>
{%- endif -%}

<!-- ============================================================
     MAIN FOOTER
     ============================================================ -->
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__main">
    <div class="site-footer__container">
      <div class="site-footer__grid">

        <!-- Col 1: Logo + Tagline + Social -->
        <div class="footer-col footer-col--brand">
          <a href="{{ routes.root_url }}" class="footer-logo" aria-label="{{ shop.name }}">
            {%- if section.settings.logo != blank -%}
              <img
                src="{{ section.settings.logo | img_url: '160x' }}"
                srcset="{{ section.settings.logo | img_url: '160x' }} 1x, {{ section.settings.logo | img_url: '320x' }} 2x"
                alt="{{ shop.name }}"
                width="{{ section.settings.logo_width | default: 120 }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="footer-logo__text">
                <svg width="36" height="36" viewBox="0 0 40 40" fill="none">
                  <polygon points="20,2 38,12 38,28 20,38 2,28 2,12" fill="#b0b8c1" opacity="0.7"/>
                  <polygon points="20,2 29,12 20,22 11,12" fill="#e8a020"/>
                  <polygon points="20,38 11,28 20,22 29,28" fill="#c0c8d0"/>
                </svg>
                <span class="footer-logo__wordmark">
                  <span class="footer-logo__brand">i<strong>TEK</strong></span>
                  <span class="footer-logo__sub">CANADA.COM</span>
                </span>
              </div>
            {%- endif -%}
          </a>

          {%- if section.settings.tagline != blank -%}
            <p class="footer-tagline">{{ section.settings.tagline }}</p>
          {%- endif -%}

          <ul class="footer-social" aria-label="Social media">
            {%- if section.settings.social_facebook != blank -%}
              <li><a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.social_twitter != blank -%}
              <li><a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener" aria-label="Twitter / X">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <li><a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <li><a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
              </a></li>
            {%- endif -%}
            {%- if section.settings.social_pinterest != blank -%}
              <li><a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.44 7.64 11.22-.1-.94-.2-2.38.04-3.4.22-.94 1.47-6.23 1.47-6.23s-.38-.75-.38-1.87c0-1.76 1.02-3.07 2.28-3.07 1.08 0 1.6.81 1.6 1.78 0 1.08-.69 2.7-1.05 4.2-.3 1.26.63 2.28 1.86 2.28 2.23 0 3.73-2.87 3.73-6.26 0-2.58-1.74-4.52-4.9-4.52-3.58 0-5.82 2.67-5.82 5.65 0 1.03.3 1.75.77 2.31.22.25.25.35.17.64-.05.21-.18.7-.23.9-.07.29-.3.39-.55.28-1.55-.63-2.27-2.34-2.27-4.26 0-3.17 2.68-6.98 8-6.98 4.28 0 7.1 3.1 7.1 6.43 0 4.42-2.44 7.73-6.03 7.73-1.21 0-2.35-.65-2.74-1.38l-.77 2.95c-.27 1.01-.97 2.27-1.47 3.05A12 12 0 0012 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/></svg>
              </a></li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Col 2: Get in Touch -->
        <div class="footer-col footer-col--contact">
          <h3 class="footer-col__heading">{{ section.settings.contact_heading | default: 'GET IN TOUCH' }}</h3>
          <ul class="footer-contact-list">
            {%- if section.settings.phone != blank -%}
              <li>
                <span class="footer-contact-list__icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.06 2.22 2 2 0 012.05.06h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.574 2.81.7A2 2 0 0122 16.92z"/></svg>
                </span>
                <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ section.settings.phone }}</a>
              </li>
            {%- endif -%}
            {%- if section.settings.contact_page != blank -%}
              <li>
                <span class="footer-contact-list__icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                </span>
                <a href="{{ section.settings.contact_page }}">{{ section.settings.contact_label | default: 'Contact Us' }}</a>
              </li>
            {%- endif -%}
            {%- if section.settings.business_hours != blank -%}
              <li>
                <span class="footer-contact-list__icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <span>{{ section.settings.business_hours }}</span>
              </li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Col 3: Company links -->
        {%- if company_menu.links.size > 0 -%}
          <div class="footer-col footer-col--links">
            <h3 class="footer-col__heading">{{ section.settings.company_heading | default: 'COMPANY' }}</h3>
            <ul class="footer-link-list">
              {%- for link in company_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <!-- Col 4: Policy links -->
        {%- if policy_menu.links.size > 0 -%}
          <div class="footer-col footer-col--links">
            <h3 class="footer-col__heading">{{ section.settings.policy_heading | default: 'POLICIES' }}</h3>
            <ul class="footer-link-list">
              {%- for link in policy_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <!-- Col 5: We Accept -->
        <div class="footer-col footer-col--payments">
          <h3 class="footer-col__heading">{{ section.settings.payment_heading | default: 'WE ACCEPT' }}</h3>
          {%- if shop.enabled_payment_types != empty -%}
            <ul class="footer-payment-list" aria-label="Accepted payment methods">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'footer-payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>

  <!-- Copyright bar -->
  <div class="site-footer__bottom">
    <div class="site-footer__container">
      <p class="footer-copyright">
        {%- assign current_year = 'now' | date: '%Y' -%}
        {%- assign year_token = '{' | append: 'year}' -%}
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text | replace: year_token, current_year }}
        {%- else -%}
          &copy; {{ current_year }} {{ shop.name }}. All Rights Reserved.
        {%- endif -%}
      </p>
    </div>
  </div>

</footer>

<!-- Floating chat / support button -->
{%- if section.settings.show_chat_btn -%}
  <a
    href="{{ section.settings.chat_url | default: '#' }}"
    class="footer-chat-btn"
    aria-label="{{ section.settings.chat_label | default: 'Chat with us' }}"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
    </svg>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Footer Custom",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Bar"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter bar",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Sign up for savings"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Subtext",
      "default": "Get the latest deals and special offers."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "newsletter_btn",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Brand Column"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (px)",
      "min": 60,
      "max": 240,
      "step": 10,
      "default": 120
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Your trusted source for batteries, office supplies, electronics & more."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter / X URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "header",
      "content": "Get in Touch"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Column heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+1 (514) MON-IIK (688-4855)"
    },
    {
      "type": "url",
      "id": "contact_page",
      "label": "Contact page URL"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "business_hours",
      "label": "Business hours",
      "default": "Mon - Fri: 9AM - 6PM EST"
    },
    {
      "type": "header",
      "content": "Company Links"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Column heading",
      "default": "COMPANY"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Policy Links"
    },
    {
      "type": "text",
      "id": "policy_heading",
      "label": "Column heading",
      "default": "POLICIES"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policies menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Column heading",
      "default": "WE ACCEPT"
    },
    {
      "type": "header",
      "content": "Copyright & Chat"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text (use {year} for auto year)",
      "default": "© {year} iTEK Canada Technologies Inc. All Rights Reserved."
    },
    {
      "type": "checkbox",
      "id": "show_chat_btn",
      "label": "Show floating chat button",
      "default": true
    },
    {
      "type": "url",
      "id": "chat_url",
      "label": "Chat button URL"
    },
    {
      "type": "text",
      "id": "chat_label",
      "label": "Chat button label",
      "default": "Chat with us"
    }
  ]
}
{% endschema %}
