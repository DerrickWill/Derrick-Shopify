{{ 'header-custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-custom.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign main_menu       = linklists[section.settings.main_menu]
  assign category_menu   = linklists[section.settings.category_menu]
-%}

<header class="site-header" id="siteHeader" role="banner">

  <!-- ============================================================
       TOP ROW: Logo · Search · Account / Cart
       ============================================================ -->
  <div class="site-header__top">
    <div class="site-header__container">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | img_url: '200x' }}"
            srcset="{{ section.settings.logo | img_url: '200x' }} 1x, {{ section.settings.logo | img_url: '400x' }} 2x"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            loading="eager"
          >
        {%- else -%}
          <div class="site-header__logo-text">
            <span class="logo-icon" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="20,2 38,12 38,28 20,38 2,28 2,12" fill="#b0b8c1" opacity="0.7"/>
                <polygon points="20,2 29,12 20,22 11,12" fill="#e8a020"/>
                <polygon points="20,38 11,28 20,22 29,28" fill="#c0c8d0"/>
              </svg>
            </span>
            <span class="logo-wordmark">
              <span class="logo-brand">i<strong>TEK</strong></span>
              <span class="logo-sub">CANADA.COM</span>
            </span>
          </div>
        {%- endif -%}
      </a>

      <!-- Search bar -->
      <div class="site-header__search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar" id="headerSearchForm">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <input type="hidden" name="q" id="searchCategoryHidden" value="">

          <!-- Category dropdown -->
          <div class="search-bar__cat" id="searchCatWrap">
            <button
              type="button"
              class="search-bar__cat-btn"
              id="searchCatBtn"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="searchCatList"
            >
              <span id="searchCatLabel">All Categories</span>
              <svg class="search-bar__cat-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
            <ul class="search-bar__cat-drop" id="searchCatList" role="listbox" hidden>
              <li role="option" aria-selected="true">
                <button type="button" class="search-bar__cat-opt is-active" data-value="">All Categories</button>
              </li>
              <li role="option" aria-selected="false">
                <button type="button" class="search-bar__cat-opt" data-value="New Arrivals">New Arrivals</button>
              </li>
              <li role="option" aria-selected="false">
                <button type="button" class="search-bar__cat-opt" data-value="Best Deals">Best Deals</button>
              </li>
              <li role="option" aria-selected="false">
                <button type="button" class="search-bar__cat-opt" data-value="Bestsellers">Bestsellers</button>
              </li>
              <li role="option" aria-selected="false">
                <button type="button" class="search-bar__cat-opt" data-value="About Us">About Us</button>
              </li>
              <li role="option" aria-selected="false">
                <button type="button" class="search-bar__cat-opt" data-value="Contact Us">Contact Us</button>
              </li>
            </ul>
          </div>

          <div class="search-bar__divider" aria-hidden="true"></div>

          <!-- Search input -->
          <input
            type="text"
            name="q"
            class="search-bar__input"
            id="headerSearchInput"
            placeholder="{{ section.settings.search_placeholder | default: 'Search for products...' }}"
            autocomplete="off"
            autocorrect="off"
            aria-label="Search"
          >

          <!-- Submit button -->
          <button type="submit" class="search-bar__submit" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Account + Cart -->
      <div class="site-header__actions">

        <!-- Account -->
        {%- if customer -%}
          <a href="{{ routes.account_url }}" class="header-action header-action--account">
            <span class="header-action__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </span>
            <span class="header-action__label">{{ customer.first_name }}</span>
          </a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="header-action header-action--account">
            <span class="header-action__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </span>
            <span class="header-action__label">Login / Register</span>
          </a>
        {%- endif -%}

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="header-action header-action--cart" id="cartAction" aria-label="Cart, {{ cart.item_count }} items">
          <span class="header-action__cart-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
            </svg>
            {%- if cart.item_count > 0 -%}
              <span class="cart-badge">{{ cart.item_count }}</span>
            {%- else -%}
              <span class="cart-badge">0</span>
            {%- endif -%}
          </span>
          <span class="header-action__cart-info">
            <span class="cart-info__count">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
            <span class="cart-info__total">{{ cart.total_price | money }}</span>
          </span>
        </a>

      </div>
    </div>
  </div>

  <!-- ============================================================
       BOTTOM ROW: Shop by Categories + Nav links
       ============================================================ -->
  <div class="site-header__nav" id="siteNav">
    <div class="site-header__container">
      <nav class="site-nav" aria-label="Main navigation">

        <!-- Shop by Categories trigger -->
        <div class="site-nav__categories" id="navCatWrap">
          <button
            class="site-nav__cat-btn"
            id="navCatBtn"
            aria-expanded="false"
            aria-controls="navCatMenu"
          >
            <svg class="site-nav__hamburger" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <rect y="1" width="16" height="2" rx="1"/>
              <rect y="7" width="16" height="2" rx="1"/>
              <rect y="13" width="16" height="2" rx="1"/>
            </svg>
            <span>Shop by Categories</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>

          <div class="site-nav__cat-menu" id="navCatMenu" hidden>
            <ul class="site-nav__cat-list">
              <li class="site-nav__cat-item">
                <a href="/collections/new-arrivals" class="site-nav__cat-link">New Arrivals</a>
              </li>
              <li class="site-nav__cat-item">
                <a href="/collections/best-deals" class="site-nav__cat-link">Best Deals</a>
              </li>
              <li class="site-nav__cat-item">
                <a href="/collections/bestsellers" class="site-nav__cat-link">Bestsellers</a>
              </li>
              <li class="site-nav__cat-item">
                <a href="/pages/about-us" class="site-nav__cat-link">About Us</a>
              </li>
              <li class="site-nav__cat-item">
                <a href="/pages/contact" class="site-nav__cat-link">Contact Us</a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Main nav links -->
        <ul class="site-nav__links">
          <li class="site-nav__item{% if request.path == '/collections/new-arrivals' %} is-active{% endif %}">
            <a href="/collections/new-arrivals" class="site-nav__link">New Arrivals</a>
          </li>
          <li class="site-nav__item{% if request.path == '/collections/best-deals' %} is-active{% endif %}">
            <a href="/collections/best-deals" class="site-nav__link">Best Deals</a>
          </li>
          <li class="site-nav__item{% if request.path == '/collections/bestsellers' %} is-active{% endif %}">
            <a href="/collections/bestsellers" class="site-nav__link">Bestsellers</a>
          </li>
          <li class="site-nav__item{% if request.path == '/pages/about-us' %} is-active{% endif %}">
            <a href="/pages/about-us" class="site-nav__link">About Us</a>
          </li>
          <li class="site-nav__item{% if request.path == '/pages/contact' %} is-active{% endif %}">
            <a href="/pages/contact" class="site-nav__link">Contact Us</a>
          </li>
        </ul>

      </nav>

      <!-- Mobile toggle -->
      <button class="site-header__mobile-toggle d-lg-none" id="mobileToggle" aria-expanded="false" aria-controls="mobileDrawer" aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="1" y1="5" x2="21" y2="5"/>
          <line x1="1" y1="11" x2="21" y2="11"/>
          <line x1="1" y1="17" x2="21" y2="17"/>
        </svg>
      </button>

    </div>
  </div>

</header>

<!-- Mobile Search -->
<div class="mobile-search d-lg-none">
  <form action="{{ routes.search_url }}" method="get" role="search" class="mobile-search__form">
    <input type="hidden" name="type" value="product">
    <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search for products...' }}" class="mobile-search__input" aria-label="Search">
    <button type="submit" class="mobile-search__btn" aria-label="Search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </form>
</div>

<!-- Mobile Drawer -->
<div class="mobile-overlay" id="mobileOverlay" hidden></div>
<nav class="mobile-drawer" id="mobileDrawer" hidden aria-label="Mobile navigation">
  <div class="mobile-drawer__header">
    <span class="mobile-drawer__title">Menu</span>
    <button class="mobile-drawer__close" id="mobileClose" aria-label="Close">&times;</button>
  </div>
  <ul class="mobile-drawer__list">
    <li class="mobile-drawer__item">
      <a href="/collections/new-arrivals" class="mobile-drawer__link">New Arrivals</a>
    </li>
    <li class="mobile-drawer__item">
      <a href="/collections/best-deals" class="mobile-drawer__link">Best Deals</a>
    </li>
    <li class="mobile-drawer__item">
      <a href="/collections/bestsellers" class="mobile-drawer__link">Bestsellers</a>
    </li>
    <li class="mobile-drawer__item">
      <a href="/pages/about-us" class="mobile-drawer__link">About Us</a>
    </li>
    <li class="mobile-drawer__item">
      <a href="/pages/contact" class="mobile-drawer__link">Contact Us</a>
    </li>
  </ul>
</nav>

{% schema %}
{
  "name": "Header Custom",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 150
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F5A623"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for products..."
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main nav menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Shop by Categories menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
