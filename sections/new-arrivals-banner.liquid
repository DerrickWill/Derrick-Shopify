
<div
  class="new-arrivals-banner section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="new-arrivals-banner__inner">
    <div class="new-arrivals-banner__text">
      {% if section.settings.heading != blank %}
        <h2 class="new-arrivals-banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="new-arrivals-banner__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="new-arrivals-banner__button"
          {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.button_label }}&nbsp;&rarr;
        </a>
      {% endif %}
    </div>

    <div class="new-arrivals-banner__images">
      {% if section.settings.image_1 %}
        {{
          section.settings.image_1
          | image_url: width: 600
          | image_tag: class: 'new-arrivals-banner__img new-arrivals-banner__img--1', loading: 'lazy'
        }}
      {% endif %}
      {% if section.settings.image_2 %}
        {{
          section.settings.image_2
          | image_url: width: 300
          | image_tag: class: 'new-arrivals-banner__img new-arrivals-banner__img--2', loading: 'lazy'
        }}
      {% endif %}
      {% if section.settings.image_3 %}
        {{
          section.settings.image_3
          | image_url: width: 300
          | image_tag: class: 'new-arrivals-banner__img new-arrivals-banner__img--3', loading: 'lazy'
        }}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .new-arrivals-banner {
    background-color: #ebebeb;
    border-radius: 16px;
    overflow: hidden;
  }

  .new-arrivals-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 40px 48px;
    min-height: 220px;
  }

  .new-arrivals-banner__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 0 0 42%;
    max-width: 42%;
  }

  .new-arrivals-banner__heading {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111111;
    margin: 0;
    line-height: 1.2;
  }

  .new-arrivals-banner__subheading {
    font-size: 0.95rem;
    color: #555555;
    margin: 0;
    line-height: 1.5;
  }

  .new-arrivals-banner__button {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: #111111;
    text-decoration: none;
    margin-top: 6px;
    transition: color 0.2s ease;
  }

  .new-arrivals-banner__button:hover {
    color: #444444;
  }

  .new-arrivals-banner__images {
    position: relative;
    flex: 1 1 auto;
    height: 200px;
  }

  .new-arrivals-banner__img {
    position: absolute;
    object-fit: contain;
  }

  .new-arrivals-banner__img--1 {
    right: 0;
    bottom: 0;
    width: 52%;
    height: 95%;
  }

  .new-arrivals-banner__img--2 {
    left: 0;
    bottom: 0;
    width: 28%;
    height: 55%;
  }

  .new-arrivals-banner__img--3 {
    right: 36%;
    bottom: 0;
    width: 26%;
    height: 52%;
  }

  @media screen and (max-width: 749px) {
    .new-arrivals-banner__inner {
      flex-direction: column;
      padding: 28px 24px;
      min-height: unset;
    }

    .new-arrivals-banner__text {
      flex: unset;
      max-width: 100%;
      width: 100%;
    }

    .new-arrivals-banner__images {
      width: 100%;
      height: 160px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "New Arrivals Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Check out the latest products"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main image (largest, right side)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary image (left)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Third image (center)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "New Arrivals Banner"
    }
  ]
}
{% endschema %}
